# Run from the repository root: vhs assets/demo.tape
Output assets/demo.gif
Set FontSize 24
Set Width 1200
Set Height 640
Set Padding 24
Set TypingSpeed 15ms
Hide
Type "export TMPDIR=/tmp"
Enter
Show
Type "# A plan and sample report — no model calls"
Enter
Type "python3 scripts/demo.py"
Enter
Sleep 6s
