{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/steven-pku/burn-before-reset/schemas/task-result.schema.json",
  "title": "Burn Before Reset Task Result",
  "type": "object",
  "required": [
    "task_id",
    "success",
    "return_code",
    "timed_out",
    "source_changed",
    "source_changed_paths",
    "worker_errors",
    "billing_error",
    "quota_exhausted",
    "burn",
    "deadline_stop",
    "guard_ready",
    "guard_failed",
    "guard_exit_code",
    "stop_confirmed",
    "stop_result",
    "descendant_cleanup_required",
    "source_check_completed",
    "error_type",
    "error_message",
    "artifact",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "return_code": {
      "type": "integer"
    },
    "timed_out": {
      "type": "boolean"
    },
    "source_changed": {
      "type": "boolean",
      "description": "An allowlisted file moved while the Worker ran. An observation, not an accusation: it does not say who moved it."
    },
    "source_write_attributable": {
      "type": "boolean",
      "description": "source_changed AND the Worker held write capability, so the movement can be attributed to it. This is the condition that fails the task and stops the run. False whenever the Worker was read-only (any Claude worker; Codex in safe mode), because a Worker with no write tool cannot have been the cause."
    },
    "source_changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowlisted paths whose size or mtime moved during the run. Evidence for source_changed; a background sync client or a concurrent agent session leaves the same trace as the Worker."
    },
    "worker_errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Error messages the Worker itself reported. Present even on a zero-exit run."
    },
    "billing_error": {
      "type": "boolean"
    },
    "quota_exhausted": {
      "type": "boolean",
      "description": "The subscription allowance ran out. An ordinary end of a window, not a billing fault."
    },
    "burn": {
      "type": "object",
      "description": "What this one worker call consumed: cost where the provider reports it, tokens always.",
      "properties": {
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "cached_input_tokens": {
          "type": "integer"
        }
      }
    },
    "deadline_stop": {
      "type": "boolean"
    },
    "guard_ready": {
      "type": "boolean"
    },
    "guard_failed": {
      "type": "boolean"
    },
    "guard_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stop_confirmed": {
      "type": "boolean"
    },
    "stop_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "descendant_cleanup_required": {
      "type": "boolean"
    },
    "source_check_completed": {
      "type": "boolean"
    },
    "error_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    }
  }
}
